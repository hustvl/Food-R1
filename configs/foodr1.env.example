# Copy this file to local.env and edit paths before launching training/evaluation.

# ms-swift checkout.
SWIFT_ROOT=/path/to/ms-swift-main

# Food-R1 repository root.
FOODR1_ROOT=/path/to/Food-R1

# Base Qwen-VL model or an SFT/RL checkpoint.
MODEL_PATH=/path/to/Qwen3-VL-8B
INITIAL_MODEL=/path/to/sft/checkpoint

# SFT datasets, separated by ":".
SFT_DATASETS=/path/to/caloriebench80k_sft.json:/path/to/cot_sft.json:/path/to/food101_sft.json:/path/to/vireo_cls_sft.json:/path/to/vireo_ing_sft.json:/path/to/fooddialogues_sft.json:/path/to/nutrition5k_sft.json:/path/to/recipe1m_sft.json

# Full CalorieBench-80K training split in ms-swift GRPO message format.
RL_DATASET=/path/to/caloriebench80k_full_train_grpo.jsonl

# Evaluation dataset and images.
EVAL_MODEL=/path/to/foodr1/checkpoint
EVAL_DATA=/path/to/caloriebench80k_val.json
IMAGE_PREFIX=/path/to/images
CALORIEBENCH80K_EVAL_DATA=/path/to/caloriebench80k_val.json
CALORIEBENCH80K_IMAGE_PREFIX=/path/to/caloriebench80k/images

# Output directories.
SFT_OUTPUT_DIR=outputs/sft_foodr1
RL_OUTPUT_DIR=outputs/grpo_caloriebench80k_full_train
EVAL_OUTPUT=outputs/pred/caloriebench80k_val
CALORIEBENCH80K_EVAL_OUTPUT=outputs/pred/caloriebench80k_val

# Auxiliary RL datasets. 
AUX_INITIAL_MODEL=/path/to/auxiliary/sft/checkpoint
VIREO172_RL_DATASETS=/path/to/vireo_trainval_dish_ingre_grpo_think.json
NUTRITION5K_RL_DATASETS=/path/to/nutrition5k_train_nutrition_qa_grpo_think.json
VIREO172_RL_OUTPUT_DIR=outputs/grpo_vireo172_ingredient
NUTRITION5K_RL_OUTPUT_DIR=outputs/grpo_nutrition5k

# Distributed defaults.
GPUS=8
NNODES=1
NODE_RANK=0
MASTER_ADDR=127.0.0.1
MASTER_PORT=29500
